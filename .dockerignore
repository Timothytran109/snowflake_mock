# Deny by default, then allow dependency manifests and required source paths.
# The final exclusions also protect sensitive/generated files inside allowed trees.
**
!requirements.txt
!requirements-dev.txt
!airflow/
!airflow/requirements.txt
!docker/
!docker/airflow.Dockerfile

# Required Airflow and dbt sources. These exceptions make them available to COPY;
# the Dockerfile copies only the required dependency manifests.
!airflow/dags/
!airflow/dags/**
!airflow/tests/
!airflow/tests/**
!dbt/
!dbt/requirements.txt
!dbt/dbt_project.yml
!dbt/models/
!dbt/models/**
!dbt/macros/
!dbt/macros/**
!dbt/tests/
!dbt/tests/**

# Keep Docker build and base Compose definitions available.
!Dockerfile
!**/Dockerfile
!**/*.Dockerfile
!docker-compose.yaml
!docker-compose.yml
!compose.yaml
!compose.yml

# These rules take precedence over source-directory exceptions above.
.git
**/.git
.venv*
**/.venv*
venv
**/venv
env
**/env
ENV
**/ENV
.env
.env.*
**/.env
**/.env.*
keys
**/keys
secrets
**/secrets
credentials
**/credentials
.dbt
**/.dbt
.local
**/.local
.azure
**/.azure
.aws
**/.aws
.ssh
**/.ssh
profiles.yml
**/profiles.yml
**/*.p8
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.der
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/simple_auth_manager_passwords.json*

# Generated dbt/Airflow/Python artifacts, including nested source-tree artifacts.
target
**/target
dbt_packages
**/dbt_packages
logs
**/logs
**/*.log
**/airflow.cfg
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.pid
__pycache__
**/__pycache__
**/*.py[cod]
**/*.pyd
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache
.mypy_cache
**/.mypy_cache
**/.coverage
**/.coverage.*
**/htmlcov

# Local datasets and Docker/runtime storage are never build inputs.
data
**/data
**/*.xlsx
**/*.xls
**/*.parquet
.docker
**/.docker
.buildx-cache
**/.buildx-cache
docker-data
**/docker-data
docker-volumes
**/docker-volumes
postgres-data
**/postgres-data
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml
